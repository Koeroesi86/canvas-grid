{
  "name": "@koeroesi86/canvas-grid",
  "version": "1.0.0",
  "description": "Canvas based grid",
  "main": "./build/web-component.js",
  "module": "./build/web-component.mjs",
  "types": "./build/types/web-component.d.ts",
  "exports": {
    ".": {
      "types": "./build/types/web-component.d.ts",
      "import": "./build/web-component.mjs",
      "require": "./build/web-component.js"
    }
  },
  "files": [
    "build"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.build.json",
    "serve-local": "node server/example-serve.mts",
    "site": "node scripts/serve-site.mts",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --test scripts/*.test.mts && vitest run",
    "bench": "vitest run --config vitest.bench.config.mts",
    "bench:scroll": "node benchmarks/scroll.bench.mts",
    "spike:offscreen": "node spikes/offscreen-worker/run.mts",
    "spike:data-worker": "node spikes/data-worker/run.mts"
  },
  "keywords": [],
  "author": {
    "name": "Krisztian Korosi",
    "url": "https://github.com/Koeroesi86"
  },
  "repository": "github:Koeroesi86/canvas-grid",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/lodash.debounce": "^4.0.9",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "lodash.debounce": "^4.0.8",
    "lodash.throttle": "^4.1.1",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "ws": "^8.22.1"
  }
}
